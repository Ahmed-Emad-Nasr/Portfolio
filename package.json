{
  "name": "sensei-106",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"app\" \"scripts\" \"*.{json,md,mjs}\"",
    "format:check": "prettier --check \"app\" \"scripts\" \"*.{json,md,mjs}\"",
    "clean": "node -e \"const fs=require('fs'); ['.next','out'].forEach((d)=>fs.rmSync(d,{recursive:true,force:true}));\"",
    "audit": "npm audit --omit=dev",
    "verify": "npm run lint && npm run type-check && npm run check:css && npm run check:data && npm run check:responsive && npm run check:assets && npm run build && npm run check:links",
    "icons": "node scripts/generate-icons.cjs",
    "gallery:shift": "node scripts/shift-art-gallery-images.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "check:links": "node scripts/check-links.mjs",
    "thumbs": "node scripts/generate-thumbs.mjs",
    "check:responsive": "node scripts/responsive-audit.mjs",
    "check:css": "node scripts/css-audit.mjs",
    "fix:type-scale": "node scripts/fix-type-scale.mjs",
    "check:dead": "node scripts/dead-code.mjs",
    "check:contrast": "node scripts/contrast-audit.mjs",
    "check:data": "node scripts/data-audit.mjs"
  },
  "dependencies": {
    "framer-motion": "^13.4.4",
    "lenis": "^1.3.26",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3"
  }
}
