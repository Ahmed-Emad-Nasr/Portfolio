{
  "name": "sensei-106",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "type-check": "node -e \"for (const d of ['.next/types', '.next/dev/types']) require('fs').rmSync(d, { recursive: true, force: true })\" && next typegen && tsc --noEmit",
    "format": "prettier --write \"app\" \"components\" \"lib\" \"data\" \"scripts\" \"*.{json,md,mjs}\"",
    "format:check": "prettier --check \"app\" \"components\" \"lib\" \"data\" \"scripts\" \"*.{json,md,mjs}\"",
    "clean": "node -e \"const fs=require('fs'); ['.next','out'].forEach((d)=>fs.rmSync(d,{recursive:true,force:true}));\"",
    "audit": "npm audit --omit=dev",
    "verify": "npm run lint && npm run type-check && npm run check:data && npm run check:assets && npm run build && npm run check:links",
    "check:data": "node scripts/data-audit.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:a11y": "node scripts/a11y-audit.mjs",
    "check:layout": "node scripts/layout-audit.mjs",
    "prepare:assets": "npm run pdf:clean && npm run thumbs && npm run hero:sizes && npm run icons && npm run og:cases",
    "pdf:clean": "node scripts/run-python.mjs scripts/pdf-clean.py public/Assets/Cases",
    "thumbs": "node scripts/generate-thumbs.mjs",
    "hero:sizes": "node scripts/generate-hero-sizes.mjs",
    "icons": "node scripts/generate-icons.cjs",
    "og:cases": "node scripts/og/generate-case-og.mjs"
  },
  "dependencies": {
    "focus-trap": "8.2.2",
    "framer-motion": "^14.6.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yet-another-react-lightbox": "^3.32.2"
  },
  "devDependencies": {
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "4.14.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "playwright": "1.63.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "micromatch": "4.0.8",
    "braces": "3.0.3",
    "glob": "10.4.5"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
