# Copy to .env.local for a local build, or set as environment variables in the
# GitHub Actions workflow. All of these are optional and read at build time.

# Privacy-friendly analytics — set ONE of these, or neither (no script at all).
# The privacy page describes whichever is enabled automatically.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=ahmed-emad-nasr.github.io
# NEXT_PUBLIC_CF_ANALYTICS_TOKEN=your-cloudflare-web-analytics-token

# Only if the site moves away from /Portfolio (the base path for assets)
# NEXT_PUBLIC_BASE_PATH=/Portfolio
